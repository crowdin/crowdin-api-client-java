{
  "name": "Resx bundle",
  "format": "crowdin-resx",
  "sourcePatterns": [
    "/master/"
  ],
  "ignorePatterns": [
    "/master/environments/"
  ],
  "exportPattern": "strings-%two_letter_code%.resx",
  "isMultilingual": true,
  "includeProjectSourceLanguage": true,
  "includeInContextPseudoLanguage": false,
  "labelIds": [
    0
  ],
  "labelMatchRule": "any",
  "excludeLabelMatchRule": "all",
  "languageIds": [
    "uk",
    "de"
  ],
  "sourceLanguageExportPattern": "strings-source.resx"
}